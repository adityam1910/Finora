# Copy to .env
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./finora.db
# MySQL:      mysql+pymysql://user:password@localhost:3306/finora
# PostgreSQL: postgresql+psycopg2://user:password@host:5432/finora
CORS_ORIGINS=http://localhost:3000
